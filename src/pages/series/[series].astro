---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, postsInSeries } from '../../lib/posts';
import { SERIES, SERIES_IDS } from '../../lib/series';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return SERIES_IDS.map((id) => ({
    params: { series: id },
    props: { id, meta: SERIES[id], posts: postsInSeries(posts, id) },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { meta, posts } = Astro.props;
---

<BaseLayout title={meta.name} description={meta.description}>
  <section class="wrap section">
    <p class="kicker">Series</p>
    <h1>{meta.name}</h1>
    <p class="series-description">{meta.description}</p>

    <ol class="series-list">
      {
        posts.map((post, i) => (
          <li class="series-item">
            <span class="series-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <PostCard post={post} />
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .series-description {
    color: var(--ink-muted);
    max-width: 40em;
    font-size: 1.2rem;
    margin-block-end: var(--space-4);
  }

  .series-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 44rem;
  }

  .series-item {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-2);
    align-items: start;
  }

  .series-index {
    font-family: var(--font-label);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--bg);
    background: var(--ink);
    border-radius: var(--radius-pill);
    padding: 0.35em 0;
    text-align: center;
    margin-block-start: var(--space-3);
  }

  @media (max-width: 44rem) {
    .series-item {
      grid-template-columns: 1fr;
    }

    .series-index {
      width: 3.5rem;
      margin-block-start: 0;
    }
  }
</style>
